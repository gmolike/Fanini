{
  "name": "@faninitiative/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next dist",
    "db:drop": "docker exec fanini-mysql-1 mysql -u root -prootpassword -e \"DROP DATABASE IF EXISTS fanini_db; CREATE DATABASE fanini_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;\"",
    "db:migrate": "node scripts/migrate-docker.cjs",
    "db:seed:auth": "node scripts/seed-auth-docker.cjs",
    "db:reset": "npm run db:drop && npm run db:migrate && npm run db:seed:auth"
  },
  "dependencies": {
    "@faninitiative/shared": "workspace:*",
    "@google-cloud/local-auth": "^3.0.1",
    "@scalar/api-reference-react": "^0.7.30",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "fs": "0.0.1-security",
    "google-auth-library": "^10.1.0",
    "googleapis": "^152.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.0",
    "next": "15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^5.26.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@faninitiative/config": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.0.7",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-react": "^5.18.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
