{
  "name": "faninitiative-spandau",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "// ========== DATABASE SHORTCUTS ========== //": "",
    "db:reset": "pnpm --filter @faninitiative/api db:reset:docker",
    "db:migrate": "pnpm --filter @faninitiative/api db:migrate",
    "db:seed": "pnpm --filter @faninitiative/api db:seed:complete",
    "db:seed:auth": "pnpm --filter @faninitiative/api db:seed:auth",
    "db:test": "pnpm --filter @faninitiative/api db:test",
    "db:reset:clean": "docker exec fanini-mysql-1 mysql -u root -prootpassword -e \"DROP DATABASE IF EXISTS fanini_db; CREATE DATABASE fanini_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;\" && pnpm db:migrate && pnpm db:seed",
    "// ========== QUICK DEV ========== //": "",
    "dev:parallel": "pnpm --parallel --filter './apps/*' dev",
    "dev:web": "pnpm --filter @faninitiative/web dev",
    "dev:api": "pnpm --filter @faninitiative/api dev"
  },
  "devDependencies": {
    "@faninitiative/config": "workspace:*",
    "concurrently": "^9.1.0",
    "prettier": "^3.6.2",
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.12.4"
  }
}
