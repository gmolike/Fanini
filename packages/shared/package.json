{
  "name": "@faninitiative/shared",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./constants": {
      "import": "./dist/constants/index.js",
      "types": "./dist/constants/index.d.ts"
    }
  },
  "scripts": {
    "generate:api-schema": "cd ../../apps/api && pnpm tsx src/scripts/generate-openapi.ts",
    "generate:types": "tsx scripts/generate-types-direct.ts",
    "generate:zod": "echo 'Skipping Zod generation for now'",
    "generate": "pnpm generate:types && pnpm format:generated",
    "format:generated": "prettier --write src/generated/**/*.ts",
    "build": "pnpm generate && tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist src/generated"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "lodash-es": "^4.17.21",
    "openapi-typescript": "^7.0.0",
    "p-debounce": "^4.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.0",
    "ts-to-zod": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "chokidar": "^4.0.3"
  }
}
