{
  "name": "@faninitiative/shared",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./constants": {
      "import": "./dist/constants/index.js",
      "types": "./dist/constants/index.d.ts"
    }
  },
  "scripts": {
    "generate:api-schema": "cd ../../apps/api && pnpm tsx src/scripts/generate-openapi.ts",
    "generate:types": "openapi-typescript src/generated/openapi.json -o src/generated/api-types.ts",
    "generate:zod": "ts-to-zod src/generated/api-types.ts src/generated/api-schemas.ts --skipParseJSDoc",
    "generate:watch": "tsx scripts/watch-types.ts",
    "generate": "pnpm generate:api-schema && pnpm generate:types && pnpm generate:zod && pnpm format:generated",
    "format:generated": "prettier --write src/generated/**/*.ts",
    "build": "pnpm generate && tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist src/generated"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.0.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.0",
    "ts-to-zod": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "lodash": "^4.17.21"
  }
}
